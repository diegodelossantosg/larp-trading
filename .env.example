# Copy to .env for local runs. In GitHub, add these as repository secrets instead.

# Claude, option 1 (default): your Claude subscription. Run `claude setup-token` and paste the token.
CLAUDE_CODE_OAUTH_TOKEN=
# Claude, option 2: pay-per-use API credit from console.anthropic.com (used instead if set).
ANTHROPIC_API_KEY=

ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Paper trading is the default. Real money needs BOTH of these changed.
ALPACA_PAPER=true
LIVE_TRADING_CONFIRMED=no

# Optional overrides (defaults shown)
# CLAUDE_BACKEND=subscription      # or "api"; picked automatically from the keys above
# CLAUDE_MODEL=sonnet               # subscription default; "opus" is stronger but uses more of your limits
#                                   # (API default: claude-opus-5-5)
# CLAUDE_EFFORT=high
# IDLE_ASSET=SPY
# MAX_POSITION_WEIGHT=0.30
# MAX_POSITIONS=8
# MAX_LEVERAGED_WEIGHT=0.10
# MAX_DAILY_TURNOVER=0.50
# REBALANCE_BAND=0.02
# MAX_DRAWDOWN_HALT=0.25
# TRADING_ENABLED=true
