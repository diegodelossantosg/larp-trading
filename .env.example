# Copy to .env for local runs. In GitHub, add these as repository secrets instead.
ANTHROPIC_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Paper trading is the default. Real money needs BOTH of these changed.
ALPACA_PAPER=true
LIVE_TRADING_CONFIRMED=no

# Optional overrides (defaults shown)
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high
# IDLE_ASSET=SPY
# MAX_POSITION_WEIGHT=0.30
# MAX_POSITIONS=8
# MAX_LEVERAGED_WEIGHT=0.10
# MAX_DAILY_TURNOVER=0.50
# REBALANCE_BAND=0.02
# MAX_DRAWDOWN_HALT=0.25
# TRADING_ENABLED=true
